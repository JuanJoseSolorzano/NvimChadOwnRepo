{
  "Insert TA Header Copyright": {
    "scope": "Python, python",
    "prefix": "copyt",
    "body": [
      "#------------------------------------------------------------------------------#",
      "# COPYRIGHT (C)                                                                #",
      "# ALL RIGHTS RESERVED.                                                         #",
      "#                                                                              #",
      "# The reproduction, transmission or use of this document or its                #",
      "# contents is not permitted without express written authority.                 #",
      "# Offenders will be liable for damages. All rights, including rights           #",
      "# created by patent grant or registration of a utility model or design,        #",
      "# are reserved.                                                                #",
      "#------------------------------------------------------------------------------#",
      "# Purpose : Test Automation Framework                                          #",
      "# Author  : ${ENV:USER}                                                        #",
      "# Date    : ${CURRENT_MONTH} ${CURRENT_YEAR}                                   #",
      "#------------------------------------------------------------------------------#",
      "$0"
    ],
    "description": "Inserts a dynamic copyright notice header at the top of the file for TA scripts"
  },
  "Insert VVMAL Header Copyright": {
    "scope": "C, c, c_pp",
    "prefix": "copyc",
    "body": [
      "/****************************************************************************************************",
      " * ALL RIGHTS RESERVED [${CURRENT_YEAR}].",
	  " *",
	  " * The reproduction, transmission or use of this document or its",
 	  " * contents is not permitted without express written authority.",
 	  " * Offenders will be liable for damages. All rights, including rights",
 	  " * created by patent grant or registration of a utility model or design, are reserved",
 	  " *----------------------------------------------------------------------------------------------------",
	  " * Purpose: VVMAL (Verification and Validation Micro Application Layer)",
	  " * File Name: [${TM_FILENAME}]",
	  " * CTRS SECTION: [<ctr section>] - <ctr title>",
    " * ALIAS: <alias>",
	  " * ",
	  " * Tool chain: DiabData [5.9.6.6-0_a_3_rh]",
	  " * Author:",
	  " * Date:",
	  " *----------------------------------------------------------------------------------------------------",
	  " * VVMAL NOTES:",
	  " *",
	  "******************************************************************************************************/",
      "$0"
    ],
    "description": "Inserts a dynamic copyright notice header at the top of the file for VVMAL C files"
  },
  "Insert vvmal feature cbd":{
    "prefix": "setcbd",
    "body": [
    "<FileDefinition>",
		"   <FileName>${1:filename}.c</FileName>",
		"   <Comment>vvmal_framework</Comment>",
		"   <FilePath></FilePath>",
		"   <isDisabled>false</isDisabled>",
		"</FileDefinition>",
    "<FileDefinition>",
		"   <FileName>${1:filename}.h</FileName>",
		"   <Comment>vvmal_framework</Comment>",
		"   <FilePath></FilePath>",
		"   <isDisabled>false</isDisabled>",
		"</FileDefinition>"
    ]
  },
  "Insert vvmal feature cbd_2":{
    "prefix": "setfeature",
    "body": [
    "<FileDefinition>",
		"   <FileName>${1:filename}.c</FileName>",
		"   <Comment>vvmal_feature</Comment>",
		"   <FilePath></FilePath>",
		"   <isDisabled>false</isDisabled>",
		"</FileDefinition>",
    "<FileDefinition>",
		"   <FileName>${1:filename}.h</FileName>",
		"   <Comment>vvmal_feature</Comment>",
		"   <FilePath></FilePath>",
		"   <isDisabled>false</isDisabled>",
		"</FileDefinition>",
    "<FileDefinition>",
		"   <FileName>${1:filename}.grl</FileName>",
		"   <Comment>vvmal_feature</Comment>",
		"   <FilePath></FilePath>",
		"   <isDisabled>false</isDisabled>",
		"</FileDefinition>"
    ]
  }

}